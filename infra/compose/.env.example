# Local development environment for `infra/compose/docker-compose.yml`.
# Copy to `.env` in this same directory (`cp .env.example .env`) and adjust if needed.
# All values below are development-only defaults. Never put real secrets here or in `.env.example`.

# --- PostgreSQL 17 (conventions-database.md §1) ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_PORT=5432

# --- db/bootstrap/00_roles.sql (paso 0.3): password for nexus_migrator and every
# svc_<service> LOGIN role. Read by the postgres container's own init script, never
# passed as a literal in SQL. Dev-only values, never real secrets. ---
NEXUS_MIGRATOR_PASSWORD=nexus_migrator_dev_password
NEXUS_SVC_PLATFORM_PASSWORD=nexus_svc_platform_dev_password
NEXUS_SVC_CATALOG_PASSWORD=nexus_svc_catalog_dev_password
NEXUS_SVC_OPERATIONS_PASSWORD=nexus_svc_operations_dev_password
NEXUS_SVC_COMMERCIAL_PASSWORD=nexus_svc_commercial_dev_password
NEXUS_SVC_RESOURCES_PASSWORD=nexus_svc_resources_dev_password
NEXUS_SVC_CONTROLLING_PASSWORD=nexus_svc_controlling_dev_password
NEXUS_SVC_FIELD_PASSWORD=nexus_svc_field_dev_password
NEXUS_SVC_RELAY_PASSWORD=nexus_svc_relay_dev_password
NEXUS_SVC_SOLVER_PASSWORD=nexus_svc_solver_dev_password

# --- Kafka (KRaft, single node) ---
KAFKA_PORT=9092

# --- Schema Registry ---
SCHEMA_REGISTRY_PORT=8081

# --- Kafka UI (kafbat) ---
KAFKA_UI_PORT=8085

# --- ClickHouse ---
CLICKHOUSE_DB=nexus_analytics
CLICKHOUSE_USER=nexus
CLICKHOUSE_PASSWORD=nexus_dev_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Azurite (Blob only) ---
AZURITE_BLOB_PORT=10000

# --- Keycloak (ADR-0006) ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# --- Aspire Dashboard (OTLP + UI) ---
OTEL_OTLP_PORT=4317
OTEL_UI_PORT=18888
