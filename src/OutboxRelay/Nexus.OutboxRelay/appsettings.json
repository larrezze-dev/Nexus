{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Nexus": {
    "Telemetry": {
      "OtlpEndpoint": "http://localhost:4317"
    },
    "Relay": {
      "_comment": "Role svc_relay (conventions-backend.md §9). The password is never here: set NEXUS__RELAY__CONNECTIONSTRING (env) or 'dotnet user-secrets set Nexus:Relay:ConnectionString ...'. Local value: NEXUS_SVC_RELAY_PASSWORD in infra/compose/.env.",
      "ConnectionString": "Host=localhost;Port=5432;Database=nexus;Username=svc_relay",
      "KafkaBootstrapServers": "localhost:9092",
      "SchemaRegistryUrl": "http://localhost:8081",
      "BatchSize": 500,
      "PollIntervalMs": 500,
      "LeaderRetrySeconds": 5,
      "MaxAttempts": 10,
      "PurgeRetentionDays": 7,
      "PurgeIntervalHours": 24,
      "PurgeChunkSize": 5000,
      "PurgeMaxChunksPerPass": 10,
      "ProduceTimeoutMs": 30000,
      "TopicPreflightTimeoutMs": 5000,
      "MaxBackoffSeconds": 60,
      "ContractsDirectory": ""
    }
  }
}
