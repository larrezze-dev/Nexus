<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nexus.OutboxRelay</RootNamespace>
  </PropertyGroup>

  <!-- Outbox relay worker (svc_relay role, conventions-events.md §4). Package versions are
       centrally managed in src/Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <!-- Microsoft.Extensions.Hosting is not in the approved package list (conventions-backend.md §10);
       the ASP.NET Core shared framework provides it without a new package (same choice as
       Nexus.BuildingBlocks.Web.csproj). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- OutboxHeaders: the keys of outbox.message.headers, single source of truth shared with OutboxWriter. -->
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Nexus.BuildingBlocks.Persistence\Nexus.BuildingBlocks.Persistence.csproj" />
  </ItemGroup>

  <!-- ADR-0018: the relay encodes every row with the local .avsc its writer validated, so it ships
       with every context's event contracts (contracts/events/<context>/*.avsc; not the _test
       fixtures). Copied next to the binaries: the default RelayOptions.ContractsDirectory. -->
  <ItemGroup>
    <None Include="..\..\..\contracts\events\**\*.avsc"
          Exclude="..\..\..\contracts\events\_test\**"
          Link="contracts\events\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexus.OutboxRelay.Tests" />
  </ItemGroup>

</Project>
